{
  "name": "fastify-demo",
  "version": "0.0.0",
  "description": "The official Fastify demo!",
  "main": "app.js",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "npm run build && node dist/server.js",
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "tsx --env-file=.env ./src/server.ts",
    "test": "npm run db:seed && c8 npm run test:run",
    "test:run": "glob -c \"tsx --test\" \"./test/**/*.ts\"",
    "lint": "eslint --ignore-pattern=dist",
    "lint:fix": "npm run lint -- --fix",
    "db:create": "tsx --env-file=.env ./scripts/create-database.ts",
    "db:drop": "tsx --env-file=.env ./scripts/drop-database.ts",
    "db:migrate": "tsx --env-file=.env ./scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env ./scripts/seed-database.ts"
  },
  "keywords": [
    "fastify",
    "demo"
  ],
  "author": "Michelet Jean <jean.antoine.michelet@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastify/demo.git"
  },
  "homepage": "https://github.com/fastify/demo#readme",
  "bugs": {
    "url": "https://github.com/fastify/demo/issues"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "busboy": "^1.6.0",
    "close-with-grace": "^2.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-stringify": "^6.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "knex": "^3.3.0",
    "mysql2": "^3.23.1",
    "pino": "^9.6.0",
    "postgrator": "^8.0.0",
    "sanitize-filename": "^1.6.4",
    "swagger-ui-express": "^5.0.1",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/http-errors": "^2.0.4",
    "@types/node": "^26.1.1",
    "@types/swagger-ui-express": "^4.1.7",
    "c8": "^12.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "form-data": "^4.0.6",
    "glob": "^11.1.0",
    "neostandard": "^0.13.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
